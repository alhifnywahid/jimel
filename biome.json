{
  "$schema": "https://biomejs.dev/schemas/2.3.0/schema.json",
  "vcs": { "enabled": false, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "apps/**/src/**",
      "packages/**/src/**",
      "!**/node_modules",
      "!**/dist",
      "!**/.wrangler",
      "!apps/web/src/components/ui"
    ]
  },
  "css": {
    "parser": { "cssModules": true, "tailwindDirectives": true },
    "linter": { "enabled": true }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": { "quoteStyle": "double", "semicolons": "always" }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": { "noNonNullAssertion": "off" },
      "suspicious": { "noExplicitAny": "off" }
    }
  }
}
