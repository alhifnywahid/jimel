{
  "name": "tempmail",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "node scripts/setup-deploy.mjs",
    "dev": "wrangler dev",
    "dev:web": "npm run dev --workspace @jimel/web",
    "build": "npm run build --workspace @jimel/web",
    "deploy": "npm run build && wrangler deploy",
    "db:init": "wrangler d1 execute tempmail --remote --file=apps/api/schema.sql",
    "db:init:local": "wrangler d1 execute tempmail --local --file=apps/api/schema.sql",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "wrangler": "^4.40.0"
  }
}
